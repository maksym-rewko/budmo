---
const links = [
  { href: '/#about',    label: 'About' },
  { href: '/#theband',  label: 'The Band' },
  { href: '/#media',    label: 'Media' },
  { href: '/#contact',  label: 'Contact' },
];
---

<header class="site-nav">
  <div class="container site-nav__inner">
    <nav class="site-nav__links" aria-label="Site navigation">
      <a href="/">Home</a>
      {links.map(link => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <button type="button" class="site-nav__book" data-book-trigger>Book</button>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 500;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Empty column 1 is a deliberate counterweight — with no logo on the
     left, it's what lets column 2 sit at the bar's true geometric center
     regardless of the Book pill's width in column 3. */
  .site-nav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .site-nav__links {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: 28px;
    font-family: var(--font-display);
    font-size: var(--text-md);
    letter-spacing: 0.04em;
  }
  .site-nav__links a {
    color: var(--text);
    transition: color var(--ease);
  }
  .site-nav__links a:hover { color: var(--accent-text); }

  .site-nav__book {
    grid-column: 3;
    justify-self: end;
    font-family: var(--font-display);
    font-size: var(--text-md);
    letter-spacing: 0.04em;
    background: var(--white);
    color: var(--ink);
    border: 1px solid var(--ink);
    padding: 8px 22px;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: background var(--ease), color var(--ease);
  }
  .site-nav__book:hover {
    background: var(--ink);
    color: var(--text-inverse);
  }

  /* ── Mobile: single-page scroll site, so the anchor links just add
     noise — visitors scroll instead of jumping via nav. With no logo to
     balance the bar, Book sits centered alone rather than pinned right. ── */
  @media (max-width: 900px) {
    .site-nav__links { display: none; }
    .site-nav__inner {
      display: flex;
      justify-content: center;
    }
    .site-nav__book { justify-self: unset; }
  }
</style>
