---
import '../styles/tokens.css';
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
}

const {
  title,
  description = site.description,
  ogImage = `${site.canonical}/assets/og-image.png`,
  ogType = 'website',
  canonical,
} = Astro.props;

const canonicalUrl = canonical ?? `${site.canonical}${Astro.url.pathname}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content={site.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={title} />

  <link rel="canonical" href={canonicalUrl} />
  <meta name="theme-color" content="#1a1a1a" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content={site.name} />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="icon" type="image/png" href="/favicon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700&display=swap" as="style" />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="preload" href="/fonts/MistralStd.otf" as="font" type="font/otf" crossorigin />

  {/* TODO: replace G-XXXXXXXXXX with the real Measurement ID once the GA4 property
      exists (create one at https://analytics.google.com) */}
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
  </script>

  <style>
    .skip-nav {
      position: absolute;
      top: -100%;
      left: 1rem;
      background: var(--ink);
      color: var(--text-inverse);
      font-family: var(--font-display);
      font-size: 14px;
      padding: 10px 20px;
      border-radius: 0 0 8px 8px;
      text-decoration: none;
      z-index: 9999;
      transition: top 0.1s;
    }
    .skip-nav:focus { top: 0; }
  </style>
</head>
<body>

  <Loader />
  <a href="#main" class="skip-nav">Skip to content</a>
  <Nav />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
