---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { eventTypes } from '../data/events';
---
<Base
  title="Book Budmo — Ukrainian Party Band"
  description="Book Budmo for your wedding, corporate event, festival, or celebration. Tell us about your event and we'll be in touch."
>

<section class="book">
  <div class="container">
    <span class="section-label">Book Budmo</span>
    <h1 class="section-title">Book Budmo for your next event</h1>

    <form
      class="book__form"
      id="booking-form"
      name="booking"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="booking" />
      <p class="sr-only"><label>Don't fill this out: <input name="bot-field" /></label></p>

      <div class="book__row">
        <div class="book__field">
          <label for="bf-first-name">First Name</label>
          <input type="text" id="bf-first-name" name="first-name" autocomplete="given-name" required />
        </div>
        <div class="book__field">
          <label for="bf-last-name">Last Name</label>
          <input type="text" id="bf-last-name" name="last-name" autocomplete="family-name" required />
        </div>
      </div>

      <div class="book__row">
        <div class="book__field">
          <label for="bf-email">Email</label>
          <input type="email" id="bf-email" name="email" autocomplete="email" required />
        </div>
        <div class="book__field">
          <label for="bf-phone">Phone</label>
          <input type="tel" id="bf-phone" name="phone" autocomplete="tel" placeholder="+1 204 000 0000" required />
        </div>
      </div>

      <div class="book__row">
        <div class="book__field">
          <label for="bf-event-date">Event Date</label>
          <input type="date" id="bf-event-date" name="event-date" required />
        </div>
        <div class="book__field">
          <label for="bf-event-type">Event Type</label>
          <select id="bf-event-type" name="event-type" required>
            <option value="" disabled selected>Select an option</option>
            {eventTypes.map(type => <option value={type}>{type}</option>)}
          </select>
        </div>
      </div>

      <div class="book__field">
        <label for="bf-event-location">Event Location</label>
        <input type="text" id="bf-event-location" name="event-location" required />
      </div>

      <div class="book__field">
        <label for="bf-requests">Requests</label>
        <textarea id="bf-requests" name="requests" placeholder="Song requests, timeline details, anything else we should know"></textarea>
      </div>

      <div class="book__status" id="bf-status" role="status" aria-live="polite"></div>

      <button type="submit" class="page-cta-btn book__submit" id="bf-submit">Send</button>

      <p class="book__privacy">We'll only use this to get back to you about your event — never shared with anyone else.</p>
    </form>
  </div>
</section>

</Base>

<style>
  .book { padding-top: 56px; }
  .book .section-title { margin-bottom: 40px; }

  .book__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 720px;
  }

  .book__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .book__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .book__field label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .book__field input,
  .book__field select,
  .book__field textarea {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--input-text);
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    border-radius: var(--radius);
    padding: 12px 14px;
    outline: none;
    width: 100%;
  }
  .book__field input:focus,
  .book__field select:focus,
  .book__field textarea:focus {
    background: var(--input-focus-bg);
    border-color: var(--text-muted);
  }
  .book__field textarea {
    resize: vertical;
    min-height: 120px;
  }

  .book__submit {
    align-self: flex-start;
    background: var(--ink);
    color: var(--text-inverse);
    border: none;
    cursor: pointer;
    font-size: var(--text-sm);
  }
  .book__submit:hover { opacity: 0.85; }
  .book__submit:disabled { opacity: 0.55; cursor: not-allowed; }

  .book__privacy {
    font-size: 13px;
    color: var(--text-muted);
  }

  .book__status {
    font-size: 13px;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    display: none;
    line-height: 1.5;
  }
  .book__status--success {
    display: block;
    background: var(--status-success-bg);
    border: 1px solid var(--status-success-border);
    color: var(--status-success-text);
  }
  .book__status--error {
    display: block;
    background: var(--status-error-bg);
    border: 1px solid var(--status-error-border);
    color: var(--status-error-text);
  }

  @media (max-width: 700px) {
    .book__row { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
(function () {
  var form   = document.getElementById('booking-form');
  var status = document.getElementById('bf-status');
  var submit = document.getElementById('bf-submit');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    submit.disabled = true;
    submit.textContent = 'Sending…';
    status.className = 'book__status';

    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(new FormData(form)).toString(),
    }).then(function (res) {
      if (res.ok) {
        status.textContent = "Success: Request sent — we'll be in touch soon.";
        status.className = 'book__status book__status--success';
        form.reset();
      } else {
        status.textContent = 'Error: Something went wrong. Please try again.';
        status.className = 'book__status book__status--error';
      }
    }).catch(function () {
      status.textContent = 'Error: Something went wrong. Please try again.';
      status.className = 'book__status book__status--error';
    }).finally(function () {
      submit.disabled = false;
      submit.textContent = 'Send';
    });
  });
})();
</script>
