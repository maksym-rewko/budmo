---
import Base from '../layouts/Base.astro';
import BandSection from '../components/BandSection.astro';
import MediaSection from '../components/MediaSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { site, aboutCopy } from '../data/site';
import { socialLinks } from '../data/media';

const musicGroupSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: site.name,
  description: site.description,
  genre: ['Ukrainian folk', 'Party band', 'Pop covers'],
  foundingDate: String(site.foundingYear),
  url: site.canonical,
  email: site.email,
  telephone: site.phone,
  areaServed: 'Winnipeg, Manitoba, Canada',
  sameAs: [socialLinks.youtube, socialLinks.instagram, socialLinks.facebook],
};
---
<Base title="Budmo — Lit Ukrainian Party Band" description={site.description}>

<script type="application/ld+json" set:html={JSON.stringify(musicGroupSchema)} />

<section id="home" class="hero section--slice-bottom">
  <div class="container hero__inner">
    <h1 class="hero__headline">
      <span class="hero__accent">Lit Ukrainian Party Band.</span>
      <span class="hero__sub">The People's Choice.</span>
    </h1>
    <button type="button" class="page-cta-btn hero__cta" data-book-trigger>Book Now</button>
  </div>
</section>

<section id="about" class="about section--after-slice">
  <div class="container about__inner">
    <div class="about__text reveal" style="--reveal-i:0">
      <span class="section-label">In the beginning</span>
      <h2 class="section-title">About Budmo</h2>
      <div class="about__copy">
        {aboutCopy.map(p => <p>{p}</p>)}
      </div>
    </div>
    <img
      class="about__map reveal"
      style="--reveal-i:1"
      src="/optimized/misc/manitoba-map-tinted.webp"
      alt="Map of Manitoba with Winnipeg marked"
      width="220"
      height="339"
      loading="lazy"
    />
  </div>
</section>

<BandSection />

<MediaSection />

<ContactSection />

</Base>

<style>
  .hero {
    background: var(--ink);
    background-image:
      linear-gradient(rgba(26,26,26,0.72), rgba(26,26,26,0.86)),
      url('/optimized/hero/hero.webp');
    background-size: cover;
    background-position: center;
    min-height: 85vh;
    display: flex;
    align-items: center;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
    padding-top: 60px;
    padding-bottom: 60px;
  }
  .hero__headline {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    color: var(--text-inverse);
    line-height: 1.05;
  }
  .hero__accent {
    display: block;
    white-space: nowrap;
    color: var(--accent);
    position: relative;
    /* Same ramp as --text-4xl (clamp(40px,5.5vw,68px)) so it stays in
       parity with .hero__sub from ~727px up — just with the floor
       extended down to 18px so it keeps shrinking on narrow phones
       instead of flooring out at 40px and overflowing. */
    font-size: clamp(18px, 5.5vw, 68px);
  }
  /* Animated underline draws in left-to-right. The 1.6s delay is tuned to
     Loader.astro's timing (its overlay holds until ~1.4s then fades over
     0.4s) so this plays as the loader clears rather than underneath it. */
  .hero__accent::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    animation: heroUnderlineDraw 0.7s var(--ease-decel) 1.6s forwards;
  }
  @keyframes heroUnderlineDraw {
    to { transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__accent::after {
      animation: none;
      transform: scaleX(1);
    }
  }
  .hero__sub {
    display: block;
    margin-top: 0.15em;
  }
  .hero__cta {
    margin-top: 8px;
    border: none;
    cursor: pointer;
  }

  @media (max-width: 600px) {
    .hero { min-height: 90vh; }
  }

  /* ── About ───────────────────────────────────────────────── */
  .about__inner {
    display: grid;
    grid-template-columns: 1.4fr auto;
    gap: 48px;
    align-items: center;
  }
  .about__text {
    max-width: 640px;
  }
  .about__copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    color: var(--text);
    font-size: var(--text-md);
    line-height: 1.7;
  }
  .about__map {
    width: 160px;
    height: auto;
    justify-self: end;
  }

  @media (max-width: 900px) {
    .about__inner {
      grid-template-columns: 1fr;
    }
    .about__map {
      order: -1;
      width: 120px;
    }
  }

  @media (max-width: 600px) {
    .about__map { display: none; }
  }
</style>
